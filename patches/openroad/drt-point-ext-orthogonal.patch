diff --git a/src/drt/src/TritonRoute.cpp b/src/drt/src/TritonRoute.cpp
index 6c636a27f..45eef1eea 100644
--- a/src/drt/src/TritonRoute.cpp
+++ b/src/drt/src/TritonRoute.cpp
@@ -32,0 +33,2 @@
+#include <cstdint>
+#include <cstdlib>
@@ -34,0 +37 @@
+#include <map>
@@ -963,0 +967,29 @@ int TritonRoute::main()
+  if (std::getenv("MLX_DRT_STOP_AFTER_IMPORT") != nullptr) {
+    std::map<frLayerNum, uint64_t> layer_lengths;
+    uint64_t total_length = 0;
+    uint64_t total_vias = 0;
+    for (const auto& net : getDesign()->getTopBlock()->getNets()) {
+      for (const auto& shape : net->getShapes()) {
+        if (shape->typeId() != frcPathSeg) {
+          continue;
+        }
+        const auto* path_seg = static_cast<const frPathSeg*>(shape.get());
+        const auto [begin, end] = path_seg->getPoints();
+        const uint64_t length = std::abs(end.x() - begin.x())
+                                + std::abs(end.y() - begin.y());
+        layer_lengths[path_seg->getLayerNum()] += length;
+        total_length += length;
+      }
+      total_vias += net->getVias().size();
+    }
+    const double dbu = getDesign()->getTech()->getDBUPerUU();
+    for (const auto& [layer_num, length] : layer_lengths) {
+      logger_->report("MLX_DRT_IMPORT_WIRE layer={} length_um={}",
+                      getDesign()->getTech()->getLayer(layer_num)->getName(),
+                      static_cast<uint64_t>(length / dbu));
+    }
+    logger_->report("MLX_DRT_IMPORT_SUMMARY wirelength_um={} vias={}",
+                    static_cast<uint64_t>(total_length / dbu),
+                    total_vias);
+    return 0;
+  }
