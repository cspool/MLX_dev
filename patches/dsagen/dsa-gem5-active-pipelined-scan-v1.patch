+std::vector<std::size_t>
+Overlay::activePipelinedBlockIndices() const
+{
+  std::vector<std::size_t> result;
+  for (uint64_t tag : active_tags_) {
+    auto blocks = tag_blocks_.find(tag);
+    if (blocks == tag_blocks_.end()) continue;
+    for (std::size_t block_index : blocks->second) {
+      const auto &state = pipelined_states_[block_index];
+      if (state.active && !state.complete) result.push_back(block_index);
+    }
+  }
+  return result;
+}
