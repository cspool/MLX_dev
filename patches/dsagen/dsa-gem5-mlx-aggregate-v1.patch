new file mode 100644
index 000000000..a5d575724
--- /dev/null
+++ b/src/cpu/minor/ssim/mlx_spad_adapter.cc
@@ -0,0 +1,137 @@
+/* See mlx_overlay.hh for license. */
+
+#include "mlx_spad_adapter.hh"
+
+#include <algorithm>
+#include <stdexcept>
+#include <vector>
+
+#include "accel.hh"
+#include "request.h"
+
+namespace dsa {
+namespace sim {
+namespace mlx {
+
+namespace {
+
+uint64_t
+BackpressureCycles(const dsa::sim::ScratchMemory &scratchpad)
+{
+  uint64_t total = 0;
+  for (const auto &bank : scratchpad.banks) {
+    total += bank.stat.read_backlog;
+    total += bank.stat.compute_backlog;
+    total += bank.stat.atomic_backlog;
+    total += bank.stat.wb_backlog;
+    total += bank.stat.decompose_backlog;
+  }
+  return total;
+}
+
+}  // namespace
+
+Gem5ScratchpadAdapter::Gem5ScratchpadAdapter(accel_t *host) : host_(host)
+{
+  if (host_ && !host_->spads.empty()) {
+    initial_bank_backpressure_ = BackpressureCycles(host_->spads.front());
+  }
+}
+
+bool
+Gem5ScratchpadAdapter::available(const MemoryRequest &request) const
+{
+  if (!host_ || host_->spads.empty() || request.bytes == 0) {
+    return false;
+  }
+  auto &scratchpad = host_->spads.front();
+  if (request.address + request.bytes > static_cast<uint64_t>(scratchpad.num_bytes) ||
+      request.address % request.bytes != 0 ||
+      request.bytes >= static_cast<unsigned>(scratchpad.bandwidth())) {
+    return false;
+  }
+  bool result = scratchpad.rb->Available() &&
+                response_to_token_.size() < MaxOutstandingTokens;
+  if (!result) {
+    ++unavailable_checks_;
+  }
+  return result;
+}
+
+uint64_t
+Gem5ScratchpadAdapter::issue(const MemoryRequest &request)
+{
+  if (!available(request)) {
+    throw std::runtime_error("DSAGEN scratchpad adapter issued while unavailable");
+  }
+  auto &scratchpad = host_->spads.front();
+  uint64_t token = next_token_++;
+  if (token > MaxOutstandingTokens) {
+    throw std::runtime_error("DSAGEN scratchpad adapter token space exhausted");
+  }
+  int response_id = ResponseBase + static_cast<int>(token);
+  dsa::sim::Request operation(
+      response_id, request.address, request.bytes,
+      request.write ? MemoryOperation::DMO_Write : MemoryOperation::DMO_Read);
+  operation.mask.assign(scratchpad.bank_width, true);
+  if (request.write) {
+    operation.operand.assign(scratchpad.bank_width, 0);
+  }
+  dsa::sim::stream::LinearStream::LineInfo metadata(
+      request.address, request.address,
+      std::vector<bool>(scratchpad.bank_width, true), 0);
+  scratchpad.rb->Decode(&scratchpad, std::vector<dsa::sim::Request>{operation}, metadata);
+  response_to_token_[static_cast<uint64_t>(response_id)] = Pending(token, host_->now());
+  ++requests_issued_;
+  return token;
+}
+
+bool
+Gem5ScratchpadAdapter::handleResponse(const dsa::sim::Response &response)
+{
+  auto iterator = response_to_token_.find(response.id);
+  if (iterator == response_to_token_.end()) {
+    return false;
+  }
+  completed_tokens_.insert(iterator->second.token);
+  uint64_t latency = host_->now() - iterator->second.issue_cycle;
+  max_response_ticks_ = std::max(max_response_ticks_, latency);
+  response_to_token_.erase(iterator);
+  ++responses_handled_;
+  return true;
+}
+
+uint64_t
+Gem5ScratchpadAdapter::bankBackpressureCycles() const
+{
+  if (!host_ || host_->spads.empty()) {
+    return 0;
+  }
+  uint64_t current = BackpressureCycles(host_->spads.front());
+  return current >= initial_bank_backpressure_ ?
+      current - initial_bank_backpressure_ : 0;
+}
+
+uint64_t
+Gem5ScratchpadAdapter::maxResponseCycles() const
+{
+  if (!host_ || host_->freq() == 0) {
+    return 0;
+  }
+  return (max_response_ticks_ + host_->freq() - 1) / host_->freq();
+}
+
+bool
+Gem5ScratchpadAdapter::takeCompletion(uint64_t token)
+{
+  auto iterator = completed_tokens_.find(token);
+  if (iterator == completed_tokens_.end()) {
+    return false;
+  }
+  completed_tokens_.erase(iterator);
+  return true;
+}
+
+}  // namespace mlx
+}  // namespace sim
+}  // namespace dsa
