+  uint64_t instructions_issued{0};
+  uint64_t instructions_completed{0};
+  uint64_t max_active_tags{0};
+  uint64_t route_hops{0};
+  uint64_t skip_hops{0};
+  uint64_t unit_hops{0};
+  uint64_t link_stalls{0};
+  uint64_t max_pipeline_issues_in_cycle{0};
+  uint64_t boundary_events_emitted{0};
+  uint64_t event_unblocked_issues_before_tag_complete{0};
+  uint64_t external_memory_requests{0};
+  uint64_t external_memory_completions{0};
+  uint64_t external_memory_wait_cycles{0};
+  std::map<PipelineKind, uint64_t> issued_by_pipeline;
+  std::map<PipelineKind, uint64_t> busy_cycles_by_pipeline;
+  std::map<std::string, uint64_t> stalls_by_reason;
+};
+
+class Overlay {
+ public:
+  Overlay(Config config, std::vector<TaggedBlock> blocks);
+
+  static std::unique_ptr<Overlay> FromJsonFile(const std::string &path);
+  static std::vector<Coord> GreedyRoute(
+      Coord source, Coord destination, const RoutingConfig &routing);
+
+  void step();
+  void run(uint64_t max_cycles);
+  void setMemoryAdapter(MemoryAdapter *adapter) { memory_adapter_ = adapter; }
+
+  bool done() const;
+  bool requiresMemoryAdapter() const {
+    return config_.memory_backend == MemoryBackend::Adapter;
+  }
+  uint64_t now() const { return cycle_; }
+  const Config &config() const { return config_; }
+  const std::vector<TaggedBlock> &blocks() const { return blocks_; }
+  const std::vector<Event> &events() const { return events_; }
+  const Stats &stats() const { return stats_; }
+
+  std::string eventsJsonLines(const std::string &scenario) const;
+  std::string summaryJson(const std::string &scenario) const;
+
+ private:
+  struct BlockState {
+    bool active{false};
+    bool complete{false};
+    bool inflight{false};
+    bool routing{false};
+    bool external_memory{false};
+    uint64_t iteration{0};
+    std::size_t pc{0};
+    uint64_t ready_cycle{0};
+    uint64_t next_hop_cycle{0};
+    std::vector<Coord> route;
+    std::size_t route_index{0};
+    uint64_t memory_token{0};
+  };
+
+  struct PipelineKey {
+    Coord pe;
+    PipelineKind pipeline{PipelineKind::Compute};
+    PipelineKey(
+        Coord pe_ = Coord(),
+        PipelineKind pipeline_ = PipelineKind::Compute)
+        : pe(pe_), pipeline(pipeline_) {}
+    bool operator<(const PipelineKey &other) const {
+      return std::tie(pe, pipeline) < std::tie(other.pe, other.pipeline);
+    }
+  };
+
+  struct FuKey {
+    Coord pe;
+    std::string resource_class;
+    FuKey(Coord pe_ = Coord(), std::string resource_class_ = "")
+        : pe(pe_), resource_class(std::move(resource_class_)) {}
+    bool operator<(const FuKey &other) const {
+      return std::tie(pe, resource_class) <
+             std::tie(other.pe, other.resource_class);
+    }
+  };
+
+  struct RegisterKey {
+    Coord pe;
+    uint64_t tag{0};
+    unsigned reg{0};
+    RegisterKey(Coord pe_ = Coord(), uint64_t tag_ = 0, unsigned reg_ = 0)
+        : pe(pe_), tag(tag_), reg(reg_) {}
+    bool operator<(const RegisterKey &other) const {
+      return std::tie(pe, tag, reg) < std::tie(other.pe, other.tag, other.reg);
+    }
+  };
+
+  struct LinkKey {
+    Coord source;
+    Coord destination;
+    LinkKey(Coord source_ = Coord(), Coord destination_ = Coord())
+        : source(source_), destination(destination_) {}
+    bool operator<(const LinkKey &other) const {
+      return std::tie(source, destination) <
+             std::tie(other.source, other.destination);
+    }
+  };
+
+  struct Candidate {
+    std::size_t block_index{0};
+    PipelineKey pipeline_key;
+    Candidate(
+        std::size_t block_index_ = 0,
+        PipelineKey pipeline_key_ = PipelineKey())
+        : block_index(block_index_), pipeline_key(pipeline_key_) {}
+  };
+
+  void validate() const;
+  void buildTagIndex();
+  void resetCycleResources();
+  void routePackets();
+  void completeInstructions();
+  void completeInstruction(std::size_t block_index);
+  void updateCompletedTags();
+  void admitTags();
+  void issueInstructions();
+  bool canIssue(std::size_t block_index, std::string *reason) const;
+  void issueInstruction(std::size_t block_index);
+  bool canWriteback(std::size_t block_index, std::string *reason) const;
+  void reserveReadPorts(const TaggedBlock &block, const Instruction &instruction);
+  void reserveWritePorts(const TaggedBlock &block, const Instruction &instruction);
+  Coord writebackPe(const TaggedBlock &block, const Instruction &instruction) const;
+  Timing instructionTiming(const Instruction &instruction) const;
+  uint64_t memoryAddress(
+      const TaggedBlock &block, const BlockState &state,
+      const Instruction &instruction) const;
+  std::string fuClass(const Instruction &instruction) const;
+  unsigned registerBank(unsigned reg) const;
+  bool tagFinished(uint64_t tag) const;
+  bool predecessorsComplete(uint64_t tag) const;
+  bool iterationEventsReady(std::size_t block_index) const;
+  void recordBusyCycles();
+  void recordEvent(
+      const std::string &kind, std::size_t block_index,
+      const std::map<std::string, std::string> &detail = {});
+  void recordTagEvent(
+      const std::string &kind, uint64_t tag,
+      const std::map<std::string, std::string> &detail = {});
+
+  Config config_;
+  std::vector<TaggedBlock> blocks_;
+  std::vector<BlockState> states_;
+  uint64_t cycle_{0};
+  std::map<uint64_t, std::vector<std::size_t>> tag_blocks_;
+  std::map<uint64_t, std::set<uint64_t>> tag_predecessors_;
+  std::set<uint64_t> active_tags_;
+  std::set<uint64_t> completed_tags_;
+  std::map<std::string, uint64_t> event_counts_;
+  std::map<std::string, uint64_t> event_producer_tags_;
+  std::map<PipelineKey, uint64_t> pipeline_next_issue_;
+  std::map<PipelineKey, std::size_t> round_robin_cursor_;
+  std::map<FuKey, uint64_t> fu_next_issue_;
+  std::set<RegisterKey> pending_writers_;
+  std::map<Coord, unsigned> rf_reads_this_cycle_;
+  std::map<Coord, unsigned> rf_writes_this_cycle_;
+  std::map<std::pair<Coord, unsigned>, unsigned> rf_read_banks_this_cycle_;
+  std::map<std::pair<Coord, unsigned>, unsigned> rf_write_banks_this_cycle_;
+  std::map<LinkKey, unsigned> links_this_cycle_;
+  std::vector<Event> events_;
+  Stats stats_;
+  MemoryAdapter *memory_adapter_{nullptr};
+};
