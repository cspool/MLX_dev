+  Event(
+      uint64_t cycle_ = 0, std::string kind_ = "", uint64_t tag_ = 0,
+      std::string block_ = "", uint64_t iteration_ = 0,
+      std::string instruction_ = "", Coord pe_ = Coord(),
+      std::string pipeline_ = "",
+      std::map<std::string, std::string> detail_ = {})
+      : cycle(cycle_), kind(std::move(kind_)), tag(tag_),
+        block(std::move(block_)), iteration(iteration_),
+        instruction(std::move(instruction_)), pe(pe_),
+        pipeline(std::move(pipeline_)), detail(std::move(detail_)) {}
+};
