+      Coord pe_ = Coord(), uint64_t tag_ = 0, std::string block_ = "",
+      std::string instruction_ = "", uint64_t iteration_ = 0)
+      : write(write_), address(address_), bytes(bytes_), pe(pe_), tag(tag_),
+        block(std::move(block_)), instruction(std::move(instruction_)),
+        iteration(iteration_) {}
