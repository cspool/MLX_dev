+struct Coord {
+  int x{0};
+  int y{0};
+
+  Coord(int x_ = 0, int y_ = 0) : x(x_), y(y_) {}
+
+  bool operator==(const Coord &other) const {
+    return x == other.x && y == other.y;
+  }
+
+  bool operator!=(const Coord &other) const { return !(*this == other); }
+
+  bool operator<(const Coord &other) const {
+    return std::tie(x, y) < std::tie(other.x, other.y);
+  }
+};
+
+enum class PipelineKind { Load = 0, Store = 1, Compute = 2, Xfer = 3 };
+
+enum class MemoryBackend { FixedLatency = 0, Adapter = 1 };
+
+const char *PipelineName(PipelineKind pipeline);
+PipelineKind ParsePipeline(const std::string &name);
+MemoryBackend ParseMemoryBackend(const std::string &name);
+
+struct Timing {
+  uint64_t latency{1};
+  uint64_t initiation_interval{1};
+
+  Timing(uint64_t latency_ = 1, uint64_t initiation_interval_ = 1)
+      : latency(latency_), initiation_interval(initiation_interval_) {}
+};
+
+struct FunctionalUnit {
+  std::string resource_class;
+  Timing timing;
+
+  FunctionalUnit(
+      std::string resource_class_ = "", Timing timing_ = Timing())
+      : resource_class(std::move(resource_class_)), timing(timing_) {}
+};
+
+struct RegisterFileConfig {
+  unsigned banks{1};
+  unsigned read_ports{1};
+  unsigned write_ports{1};
+
+  RegisterFileConfig(
+      unsigned banks_ = 1, unsigned read_ports_ = 1,
+      unsigned write_ports_ = 1)
+      : banks(banks_), read_ports(read_ports_), write_ports(write_ports_) {}
