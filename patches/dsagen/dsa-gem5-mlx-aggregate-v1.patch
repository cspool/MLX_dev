+/* See mlx_overlay.hh for license. */
+
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <set>
+
+#include "mlx_overlay.hh"
+
+class accel_t;
+
+namespace dsa {
+namespace sim {
+struct Response;
+}
+}
+
+namespace dsa {
+namespace sim {
+namespace mlx {
+
+class Gem5ScratchpadAdapter : public MemoryAdapter {
+ public:
+  explicit Gem5ScratchpadAdapter(accel_t *host);
+
+  bool available(const MemoryRequest &request) const override;
+  uint64_t issue(const MemoryRequest &request) override;
+  bool takeCompletion(uint64_t token) override;
+
+  bool handleResponse(const dsa::sim::Response &response);
+  uint64_t requestsIssued() const { return requests_issued_; }
+  uint64_t responsesHandled() const { return responses_handled_; }
+  uint64_t unavailableChecks() const { return unavailable_checks_; }
+  uint64_t maxResponseTicks() const { return max_response_ticks_; }
+  uint64_t maxResponseCycles() const;
+  uint64_t bankBackpressureCycles() const;
+
+ private:
+  static const int ResponseBase = 0x3f000000;
+  static const uint64_t MaxOutstandingTokens = 0x000fffff;
+
+  struct Pending {
+    uint64_t token{0};
+    uint64_t issue_cycle{0};
+    Pending(uint64_t token_ = 0, uint64_t issue_cycle_ = 0)
+        : token(token_), issue_cycle(issue_cycle_) {}
+  };
+
+  accel_t *host_;
+  uint64_t next_token_{1};
+  uint64_t requests_issued_{0};
+  uint64_t responses_handled_{0};
+  mutable uint64_t unavailable_checks_{0};
+  uint64_t max_response_ticks_{0};
+  uint64_t initial_bank_backpressure_{0};
+  std::map<uint64_t, Pending> response_to_token_;
+  std::set<uint64_t> completed_tokens_;
+};
+
+}  // namespace mlx
+}  // namespace sim
+}  // namespace dsa
