+PeDependencyModel
+ParsePeDependencyModel(const std::string &name)
+{
+  if (name == "paper_static") return PeDependencyModel::PaperStatic;
+  if (name.empty() || name == "scoreboard_experimental" ||
+      name == "scoreboard") {
+    return PeDependencyModel::ScoreboardExperimental;
+  }
+  throw std::runtime_error("unknown MLX PE dependency model: " + name);
