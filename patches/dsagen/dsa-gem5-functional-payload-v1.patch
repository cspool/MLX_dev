+double
+Overlay::functionalRegisterValue(
+    Coord pe, uint64_t tag, uint64_t iteration, unsigned reg) const
+{
+  auto iterator = functional_registers_.find({pe, tag, iteration, reg});
+  if (iterator == functional_registers_.end()) {
+    throw std::runtime_error(
+        "functional register read before write: PE(" +
+        std::to_string(pe.x) + "," + std::to_string(pe.y) + ") tag=" +
+        std::to_string(tag) + " iteration=" + std::to_string(iteration) +
+        " reg=" + std::to_string(reg));
+  }
+  return iterator->second;
+}
+
+void
+Overlay::executeFunctional(
+    const TaggedBlock &block, const Instruction &instruction,
+    uint64_t iteration)
+{
+  if (!config_.functional_execution) return;
+  try {
+    std::vector<double> operands;
+    for (unsigned reg : instruction.reads) {
+      operands.push_back(
+          functionalRegisterValue(block.pe, block.tag, iteration, reg));
+    }
+    operands.insert(
+        operands.end(), instruction.immediates.begin(),
+        instruction.immediates.end());
+    double result = 0.0;
+    if (instruction.pipeline == PipelineKind::Load) {
+      uint64_t address = memoryAddress(instruction, iteration);
+      auto value = functional_memory_.find(address);
+      if (value == functional_memory_.end()) {
+        if (config_.functional_strict_memory) {
+          throw std::runtime_error(
+              "functional load address is uninitialized: " +
+              std::to_string(address));
+        }
+        result = 0.0;
+      } else {
+        result = value->second;
+      }
+    } else if (instruction.pipeline == PipelineKind::Store) {
+      result = operands.at(0);
+      functional_memory_[memoryAddress(instruction, iteration)] = result;
+    } else if (instruction.pipeline == PipelineKind::Xfer) {
+      result = operands.at(0);
+    } else if (instruction.operation == "add") {
+      result = operands.at(0) + operands.at(1);
+    } else if (instruction.operation == "mul") {
+      result = operands.at(0) * operands.at(1);
+    } else if (instruction.operation == "fma") {
+      result = std::fma(operands.at(0), operands.at(1), operands.at(2));
+    } else if (instruction.operation == "fmax") {
+      result = std::fmax(operands.at(0), operands.at(1));
+    } else if (instruction.operation == "fexp") {
+      result = std::exp(operands.at(0));
+    } else if (instruction.operation == "fdiv") {
+      result = operands.at(0) / operands.at(1);
+    } else if (instruction.operation == "frsqrt") {
+      result = 1.0 / std::sqrt(operands.at(0));
+    } else if (instruction.operation == "shuffle") {
+      result = operands.at(0);
+    } else {
+      throw std::runtime_error(
+          "unsupported functional operation: " + instruction.operation);
+    }
+    if (!std::isfinite(result)) {
+      ++stats_.functional_nan_values;
+    }
+    if (instruction.pipeline == PipelineKind::Xfer) {
+      for (unsigned reg : instruction.writes) {
+        functional_registers_[
+            {instruction.destination, instruction.destination_tag, iteration,
+             reg}] = result;
+      }
+    } else if (instruction.pipeline != PipelineKind::Store) {
+      for (unsigned reg : instruction.writes) {
+        functional_registers_[{block.pe, block.tag, iteration, reg}] = result;
+      }
+    }
+    ++stats_.functional_operations;
+  } catch (...) {
+    ++stats_.functional_errors;
+    throw;
+  }
+}
