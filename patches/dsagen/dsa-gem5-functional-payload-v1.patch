+double
+FiniteDouble(const Json::Value &value, const std::string &field)
+{
+  if (!value.isNumeric()) {
+    throw std::runtime_error(field + " must be numeric");
+  }
+  double result = value.asDouble();
+  if (!std::isfinite(result)) {
+    throw std::runtime_error(field + " must be finite");
+  }
+  return result;
+}
