+void
+Overlay::recordContextEvent(
+    const std::string &kind, ContextRef ref,
+    const std::map<std::string, std::string> &detail)
+{
+  if (!config_.record_events) return;
+  const auto &block = blocks_[ref.block_index];
+  const auto &context =
+      pipelined_states_[ref.block_index].contexts[ref.context_index];
+  const auto &instruction = block.instructions[context.pc];
+  auto enriched = detail;
+  enriched["task_id"] = std::to_string(block.task_id);
+  enriched["block_id"] = std::to_string(block.numeric_block_id);
+  enriched["instance"] =
+      std::to_string(block.instance_base + context.iteration);
+  enriched["context_slot"] = std::to_string(ref.context_index);
+  enriched["network_plane"] = std::to_string(instruction.network_plane);
+  events_.push_back(
+      {cycle_, kind, block.tag, block.id, context.iteration, instruction.id,
+       block.pe, PipelineName(instruction.pipeline), enriched});
+}
