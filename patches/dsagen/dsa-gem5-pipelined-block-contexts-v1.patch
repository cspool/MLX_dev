+void
+Overlay::stepPipelined()
+{
+  if (memory_adapter_) {
+    memory_adapter_->advance(cycle_);
+  }
+  resetCycleResources();
+  routePipelinedPackets();
+  completePipelinedInstructions();
+  updateCompletedTags();
+  admitTags();
+  issuePipelinedInstructions();
+  recordPipelinedBusyCycles();
+  ++cycle_;
+  stats_.cycles = cycle_;
+}
+
+void
+Overlay::refillPipelinedContexts(std::size_t block_index)
+{
+  auto &block_state = pipelined_states_[block_index];
+  const auto &block = blocks_[block_index];
+  if (!block_state.active || block_state.complete) return;
+  for (auto &context : block_state.contexts) {
+    if (context.valid || block_state.next_iteration >= block.trip_count) {
+      continue;
+    }
+    context = IterationContext();
+    context.valid = true;
+    context.iteration = block_state.next_iteration++;
+  }
+  uint64_t active = 0;
+  for (const auto &context : block_state.contexts) {
+    active += context.valid;
+  }
+  stats_.max_inflight_iterations_per_block = std::max(
+      stats_.max_inflight_iterations_per_block, active);
+}
+
+void
+Overlay::routePipelinedPackets()
+{
+  std::vector<ContextRef> ready;
+  for (std::size_t block_index = 0;
+       block_index < pipelined_states_.size(); ++block_index) {
+    const auto &state = pipelined_states_[block_index];
+    for (std::size_t context_index = 0;
+         context_index < state.contexts.size(); ++context_index) {
+      const auto &context = state.contexts[context_index];
+      if (context.valid && context.inflight && context.routing &&
+          context.next_hop_cycle <= cycle_) {
+        ready.push_back({block_index, context_index});
+      }
+    }
+  }
+  std::sort(
+      ready.begin(), ready.end(), [this](ContextRef left, ContextRef right) {
+        const auto &left_block = blocks_[left.block_index];
+        const auto &right_block = blocks_[right.block_index];
+        const auto &left_context =
+            pipelined_states_[left.block_index].contexts[left.context_index];
+        const auto &right_context =
+            pipelined_states_[right.block_index].contexts[right.context_index];
+        return std::tie(
+                   left_block.task_id, left_block.numeric_block_id,
+                   left_context.iteration, left_block.id, left.context_index) <
+               std::tie(
+                   right_block.task_id, right_block.numeric_block_id,
+                   right_context.iteration, right_block.id, right.context_index);
+      });
+  for (ContextRef ref : ready) {
+    auto &context =
+        pipelined_states_[ref.block_index].contexts[ref.context_index];
+    const auto &block = blocks_[ref.block_index];
+    const auto &instruction = block.instructions[context.pc];
+    Coord source = context.route[context.route_index];
+    Coord destination = context.route[context.route_index + 1];
+    LinkKey link{source, destination, instruction.network_plane};
+    if (links_this_cycle_[link] >= config_.routing.link_capacity) {
+      ++stats_.link_stalls;
+      ++stats_.stalls_by_reason["link_capacity"];
+      recordContextEvent("stall", ref, {{"reason", "link_capacity"}});
+      continue;
+    }
+    ++links_this_cycle_[link];
+    ++context.route_index;
+    ++stats_.route_hops;
+    ++stats_.route_hops_by_plane[instruction.network_plane];
+    int distance = std::abs(destination.x - source.x) +
+                   std::abs(destination.y - source.y);
+    if (distance > 1) {
+      ++stats_.skip_hops;
+    } else {
+      ++stats_.unit_hops;
+    }
+    recordContextEvent(
+        "route_hop", ref,
+        {{"from", std::to_string(source.x) + "," + std::to_string(source.y)},
+         {"to", std::to_string(destination.x) + "," +
+                    std::to_string(destination.y)},
+         {"step", std::to_string(distance)},
+         {"residual_hops", std::to_string(
+              context.route.size() - context.route_index - 1)}});
+    if (context.route_index + 1 == context.route.size()) {
+      context.routing = false;
+      context.ready_cycle = cycle_ + config_.routing.latency_per_hop;
+    } else {
+      context.next_hop_cycle = cycle_ + config_.routing.latency_per_hop;
+    }
+  }
+}
+
+void
+Overlay::completePipelinedInstructions()
+{
+  std::vector<ContextRef> ready;
+  for (std::size_t block_index = 0;
+       block_index < pipelined_states_.size(); ++block_index) {
+    auto &state = pipelined_states_[block_index];
+    for (std::size_t context_index = 0;
+         context_index < state.contexts.size(); ++context_index) {
+      auto &context = state.contexts[context_index];
+      ContextRef ref{block_index, context_index};
+      if (!context.valid || !context.inflight) continue;
+      if (context.external_memory) {
+        if (memory_adapter_ &&
+            memory_adapter_->takeCompletion(context.memory_token)) {
+          context.external_memory = false;
+          context.ready_cycle = cycle_;
+          ++stats_.external_memory_completions;
+          recordContextEvent(
+              "memory_response", ref,
+              {{"memory_token", std::to_string(context.memory_token)}});
+        } else {
+          ++stats_.external_memory_wait_cycles;
+        }
+      }
+      if (!context.routing && context.ready_cycle <= cycle_) {
+        ready.push_back(ref);
+      }
+    }
+  }
+  std::sort(
+      ready.begin(), ready.end(), [this](ContextRef left, ContextRef right) {
+        const auto &left_block = blocks_[left.block_index];
+        const auto &right_block = blocks_[right.block_index];
+        const auto &left_context =
+            pipelined_states_[left.block_index].contexts[left.context_index];
+        const auto &right_context =
+            pipelined_states_[right.block_index].contexts[right.context_index];
+        return std::tie(
+                   left_block.task_id, left_block.numeric_block_id,
+                   left_context.iteration, left_block.id, left.context_index) <
+               std::tie(
+                   right_block.task_id, right_block.numeric_block_id,
+                   right_context.iteration, right_block.id, right.context_index);
+      });
+  for (ContextRef ref : ready) {
+    completePipelinedInstruction(ref);
+  }
+}
+
+void
+Overlay::completePipelinedInstruction(ContextRef ref)
+{
+  auto &block_state = pipelined_states_[ref.block_index];
+  auto &context = block_state.contexts[ref.context_index];
+  const auto &block = blocks_[ref.block_index];
+  const auto &instruction = block.instructions[context.pc];
+  recordContextEvent("complete", ref);
+  ++stats_.instructions_completed;
+  if (!instruction.emit_event.empty() &&
+      (context.iteration + 1) % instruction.emit_event_period == 0) {
+    uint64_t count = ++event_counts_[instruction.emit_event];
+    ++stats_.boundary_events_emitted;
+    recordContextEvent(
+        "event_emit", ref,
+        {{"event", instruction.emit_event}, {"count", std::to_string(count)}});
+  }
+  context.inflight = false;
+  context.frfo_ready_cycle = ~uint64_t{0};
+  context.external_memory = false;
+  context.memory_token = 0;
+  context.service_ready_cycle = 0;
+  context.route.clear();
+  context.route_index = 0;
+  ++context.pc;
+  if (context.pc != block.instructions.size()) return;
+
+  ++block_state.completed_iterations;
+  if (config_.record_events) {
+    events_.push_back(
+        {cycle_, "iteration_complete", block.tag, block.id,
+         context.iteration + 1, instruction.id, block.pe,
+         PipelineName(instruction.pipeline),
+         {{"completed_iterations",
+           std::to_string(block_state.completed_iterations)},
+          {"context_slot", std::to_string(ref.context_index)},
+          {"instance", std::to_string(
+               block.instance_base + context.iteration)},
+          {"task_id", std::to_string(block.task_id)},
+          {"block_id", std::to_string(block.numeric_block_id)}}});
+  }
+  context.valid = false;
+  context.pc = 0;
+  if (block_state.completed_iterations == block.trip_count) {
+    block_state.complete = true;
+    block_state.active = false;
+    if (config_.record_events) {
+      events_.push_back(
+          {cycle_, "block_complete", block.tag, block.id, block.trip_count,
+           instruction.id, block.pe, PipelineName(instruction.pipeline), {}});
+    }
+  } else {
+    refillPipelinedContexts(ref.block_index);
+  }
+}
+
+bool
+Overlay::canIssuePipelined(ContextRef ref, std::string *reason) const
+{
+  const auto &block = blocks_[ref.block_index];
+  const auto &context =
+      pipelined_states_[ref.block_index].contexts[ref.context_index];
+  const auto &instruction = block.instructions[context.pc];
+  if (context.pc == 0 &&
+      !iterationEventsReady(ref.block_index, context.iteration)) {
+    *reason = "event_dependency";
+    return false;
+  }
+  if ((instruction.pipeline == PipelineKind::Load ||
+       instruction.pipeline == PipelineKind::Store) &&
+      instruction.memory_external &&
+      config_.memory_backend != MemoryBackend::FixedLatency) {
+    if (!memory_adapter_) {
+      *reason = "memory_adapter_missing";
+      return false;
+    }
+    MemoryRequest request(
+        instruction.pipeline == PipelineKind::Store,
+        memoryAddress(instruction, context.iteration), instruction.memory_bytes,
+        block.pe, block.tag, block.id, instruction.id, context.iteration);
+    if (!memory_adapter_->available(request)) {
+      *reason = "memory_queue_full";
+      return false;
+    }
+  }
+  PipelineKey pipeline_key{block.pe, instruction.pipeline};
+  auto pipeline = pipeline_next_issue_.find(pipeline_key);
+  if (pipeline != pipeline_next_issue_.end() && pipeline->second > cycle_) {
+    *reason = "pipeline_initiation";
+    return false;
+  }
+  if (instruction.pipeline == PipelineKind::Compute) {
+    FuKey fu_key{block.pe, fuClass(instruction)};
+    auto fu = fu_next_issue_.find(fu_key);
+    if (fu != fu_next_issue_.end() && fu->second > cycle_) {
+      *reason = "fu_initiation";
+      return false;
+    }
+  }
+  return true;
+}
+
+void
+Overlay::issuePipelined(ContextRef ref)
+{
+  const auto &block = blocks_[ref.block_index];
+  auto &context =
+      pipelined_states_[ref.block_index].contexts[ref.context_index];
+  const auto &instruction = block.instructions[context.pc];
+  uint64_t frfo_ready_cycle = context.frfo_ready_cycle;
+  Timing timing = instructionTiming(instruction);
+  Timing pipeline_timing = config_.pipeline_timing.at(instruction.pipeline);
+  if (context.pc == 0) {
+    for (const auto &event : block.wait_events) {
+      uint64_t producer_tag = event_producer_tags_.at(event);
+      if (!completed_tags_.count(producer_tag)) {
+        ++stats_.event_unblocked_issues_before_tag_complete;
+        break;
+      }
+    }
+  }
+  PipelineKey pipeline_key{block.pe, instruction.pipeline};
+  pipeline_next_issue_[pipeline_key] =
+      cycle_ + pipeline_timing.initiation_interval;
+  if (instruction.pipeline == PipelineKind::Compute) {
+    fu_next_issue_[{block.pe, fuClass(instruction)}] =
+        cycle_ + timing.initiation_interval;
+  }
+  context.inflight = true;
+  context.frfo_ready_cycle = ~uint64_t{0};
+  context.routing = false;
+  context.external_memory = false;
+  context.ready_cycle = cycle_ + timing.latency;
+  context.service_ready_cycle = cycle_ + timing.latency;
+  if ((instruction.pipeline == PipelineKind::Load ||
+       instruction.pipeline == PipelineKind::Store) &&
+      instruction.memory_external &&
+      config_.memory_backend != MemoryBackend::FixedLatency) {
+    MemoryRequest request(
+        instruction.pipeline == PipelineKind::Store,
+        memoryAddress(instruction, context.iteration), instruction.memory_bytes,
+        block.pe, block.tag, block.id, instruction.id, context.iteration);
+    context.memory_token = memory_adapter_->issue(request);
+    context.external_memory = true;
+    context.ready_cycle = std::numeric_limits<uint64_t>::max();
+    ++stats_.external_memory_requests;
+  } else if (instruction.pipeline == PipelineKind::Xfer &&
+             block.pe != instruction.destination) {
+    context.route = GreedyRoute(block.pe, instruction.destination, config_.routing);
+    context.route_index = 0;
+    context.routing = true;
+    context.next_hop_cycle = cycle_ + 1;
+    context.ready_cycle = std::numeric_limits<uint64_t>::max();
+  }
+  std::map<std::string, std::string> detail = {
+      {"latency", std::to_string(timing.latency)},
+      {"initiation_interval", std::to_string(timing.initiation_interval)},
+      {"operation", instruction.operation},
+      {"fu_class", fuClass(instruction)},
+      {"frfo_ready_cycle", std::to_string(frfo_ready_cycle)}};
+  detail["memory_backend"] =
+      !instruction.memory_external ? "local" :
+      (context.external_memory ?
+       (config_.memory_backend == MemoryBackend::DmaAdapter ? "dsagen_dma" :
+        (config_.memory_backend == MemoryBackend::DpuMemoryAdapter ?
+         "dpu_memory" : "adapter")) : "fixed");
+  if (context.external_memory) {
+    detail["memory_token"] = std::to_string(context.memory_token);
+  }
+  if (instruction.pipeline == PipelineKind::Load ||
+      instruction.pipeline == PipelineKind::Store) {
+    detail["memory_address"] =
+        std::to_string(memoryAddress(instruction, context.iteration));
+  }
+  recordContextEvent("issue", ref, detail);
+  ++stats_.instructions_issued;
+  ++stats_.dpu_frfo_issues;
+  ++stats_.issued_by_pipeline[instruction.pipeline];
+  issued_pipelines_this_cycle_.insert(instruction.pipeline);
+}
+
+void
+Overlay::issuePipelinedInstructions()
+{
+  std::vector<ContextCandidate> candidates;
+  for (std::size_t block_index = 0;
+       block_index < pipelined_states_.size(); ++block_index) {
+    auto &state = pipelined_states_[block_index];
+    if (!state.active || state.complete) continue;
+    refillPipelinedContexts(block_index);
+    for (std::size_t context_index = 0;
+         context_index < state.contexts.size(); ++context_index) {
+      auto &context = state.contexts[context_index];
+      if (!context.valid || context.inflight) continue;
+      const auto &block = blocks_[block_index];
+      const auto &instruction = block.instructions[context.pc];
+      if (context.pc == 0 &&
+          !iterationEventsReady(block_index, context.iteration)) {
+        context.frfo_ready_cycle = ~uint64_t{0};
+        continue;
+      }
+      if (context.frfo_ready_cycle == ~uint64_t{0}) {
+        context.frfo_ready_cycle = cycle_;
+      }
+      candidates.push_back(
+          {{block_index, context_index},
+           {block.pe, instruction.pipeline}, context.frfo_ready_cycle});
+    }
+  }
+  std::sort(
+      candidates.begin(), candidates.end(),
+      [this](const ContextCandidate &left, const ContextCandidate &right) {
+        const auto &left_block = blocks_[left.ref.block_index];
+        const auto &right_block = blocks_[right.ref.block_index];
+        const auto &left_context =
+            pipelined_states_[left.ref.block_index]
+                .contexts[left.ref.context_index];
+        const auto &right_context =
+            pipelined_states_[right.ref.block_index]
+                .contexts[right.ref.context_index];
+        return std::make_tuple(
+                   left.pipeline_key.pe, left.pipeline_key.pipeline,
+                   left.ready_cycle, left_block.task_id,
+                   left_block.numeric_block_id, left_context.iteration,
+                   left_block.id, left.ref.context_index) <
+               std::make_tuple(
+                   right.pipeline_key.pe, right.pipeline_key.pipeline,
+                   right.ready_cycle, right_block.task_id,
+                   right_block.numeric_block_id, right_context.iteration,
+                   right_block.id, right.ref.context_index);
+      });
+  std::set<PipelineKey> issued;
+  uint64_t issued_this_cycle = 0;
+  for (const auto &candidate : candidates) {
+    if (issued.count(candidate.pipeline_key)) {
+      ++stats_.stalls_by_reason["pipeline_contention"];
+      recordContextEvent(
+          "stall", candidate.ref, {{"reason", "pipeline_contention"}});
+      continue;
+    }
+    std::string reason;
+    if (!canIssuePipelined(candidate.ref, &reason)) {
+      ++stats_.stalls_by_reason[reason];
+      recordContextEvent("stall", candidate.ref, {{"reason", reason}});
+      continue;
+    }
+    issuePipelined(candidate.ref);
+    issued.insert(candidate.pipeline_key);
+    ++issued_this_cycle;
+  }
+  stats_.max_pipeline_issues_in_cycle =
+      std::max(stats_.max_pipeline_issues_in_cycle, issued_this_cycle);
+}
+
+void
+Overlay::recordPipelinedBusyCycles()
+{
+  std::set<PipelineKind> busy;
+  std::set<PipelineKind> productive;
+  std::set<PipelineKey> resident_pe;
+  std::set<PipelineKey> productive_pe;
+  std::set<FuKey> productive_fu;
+  for (std::size_t block_index = 0;
+       block_index < pipelined_states_.size(); ++block_index) {
+    const auto &block = blocks_[block_index];
+    for (const auto &context : pipelined_states_[block_index].contexts) {
+      if (!context.valid || !context.inflight) continue;
+      const auto &instruction = block.instructions[context.pc];
+      PipelineKind pipeline = instruction.pipeline;
+      PipelineKey key{block.pe, pipeline};
+      busy.insert(pipeline);
+      resident_pe.insert(key);
+      bool external_memory_wait =
+          (pipeline == PipelineKind::Load || pipeline == PipelineKind::Store) &&
+          context.external_memory && context.service_ready_cycle <= cycle_;
+      if (!external_memory_wait) {
+        productive.insert(pipeline);
+        productive_pe.insert(key);
+        if (pipeline == PipelineKind::Compute) {
+          productive_fu.insert({block.pe, fuClass(instruction)});
+        }
+      }
+    }
+  }
+  for (PipelineKind pipeline : busy) {
+    ++stats_.busy_cycles_by_pipeline[pipeline];
+  }
+  for (const auto &key : resident_pe) {
+    ++stats_.resident_pe_cycles_by_pipeline[key.pipeline];
+  }
+  for (const auto &key : productive_pe) {
+    ++stats_.productive_pe_cycles_by_pipeline[key.pipeline];
+  }
+  for (PipelineKind pipeline : productive) {
+    ++stats_.productive_global_cycles_by_pipeline[pipeline];
+  }
+  for (PipelineKind pipeline : issued_pipelines_this_cycle_) {
+    ++stats_.issue_cycles_by_pipeline[pipeline];
+  }
+  for (const auto &key : productive_fu) {
+    ++stats_.productive_pe_cycles_by_fu_class[key.resource_class];
+  }
+}
