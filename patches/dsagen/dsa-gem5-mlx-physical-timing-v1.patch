+
+void
+Overlay::physicalStallStep()
+{
+  resetCycleResources();
+  if (memory_adapter_ != nullptr) {
+    memory_adapter_->advance(cycle_);
+  }
+  ++cycle_;
+  ++injected_congestion_stall_cycles_;
+  ++stats_.stalls_by_reason["physical_congestion"];
+  stats_.cycles = cycle_;
 }
 
